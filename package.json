{
  "name": "dsh-reject-policy",
  "version": "0.1.0",
  "description": "DSH plugin: rewrite denial messages and optionally stop the turn when a tool call is rejected by the user.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/reject-policy-check.mts",
    "build": "tsc -p tsconfig.json && tsdown",
    "ci:drift": "tsx scripts/check-official-template.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
