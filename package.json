{
  "name": "dsh-reject-policy",
  "version": "0.2.0",
  "description": "DSH plugin: rewrite denial messages and optionally stop the turn when a tool call is rejected by the user.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "test": "pnpm ci:drift && tsx tests/reject-policy-check.mts",
    "build": "pnpm ci:drift && tsc -p tsconfig.json && tsdown",
    "ci:drift": "tsx scripts/check-official-template.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsx": "^4.19.0",
    "tsdown": "^0.22.2",
    "lightningcss": "^1.27.0",
    "typescript": "^5.6.0"
  }
}
